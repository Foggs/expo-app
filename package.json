{
  "name": "expo-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "local:dev:web": "bash scripts/dev-local.sh --web",
    "local:dev:mobile": "bash scripts/dev-local.sh --mobile --lan",
    "local:dev:mobile:ngrok": "bash scripts/dev-local.sh --mobile --ngrok",
    "expo:dev": "EXPO_PACKAGER_PROXY_URL=https://$REPLIT_DEV_DOMAIN REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_SERVER_PORT=${PORT:-${SERVER_PORT:-5050}} EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN:${PORT:-${SERVER_PORT:-5050}} PORT=${PORT:-${SERVER_PORT:-5050}} npx expo start --localhost",
    "server:dev": "NODE_ENV=development tsx server/index.ts",
    "expo:start:static:build": "npx expo start --no-dev --minify --localhost",
    "expo:static:build": "node scripts/build.js",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "db:push": "drizzle-kit push",
    "start": "npx expo start",
    "lint": "npx expo lint",
    "lint:fix": "npx expo lint --fix"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@neondatabase/serverless": "^1.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@types/ws": "^8.18.1",
    "@ungap/structured-clone": "^1.3.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "expo": "~58.0.24",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-blur": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.10",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tsx": "^4.20.6",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@types/express": "^5.0.0",
    "@types/react": "~19.3.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "babel-preset-expo": "~58.0.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~58.0.4",
    "patch-package": "^8.0.0",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "private": true,
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.21",
    "decode-uri-component": "0.5.1",
    "@expo/metro-config": {
      "postcss": "8.5.32"
    }
  }
}
